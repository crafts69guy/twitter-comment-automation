# Environment Variables Template
# Copy this file to .env and fill in your actual values

# AI API Keys (Choose one or more providers)
# The app will use the key based on the provider selected in UI Settings
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets Service Account (Required)
GOOGLE_SERVICE_ACCOUNT_PATH=./google-credentials.json

# Session Configuration (Required)
SESSION_SECRET=your_super_secret_session_key_here_minimum_32_characters

# Application Configuration
NODE_ENV=production
PORT=3001

# Optional: Database connection if you want to add persistence
# DATABASE_URL=postgresql://user:password@localhost:5432/twitter_automation

# Optional: Email configuration for notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Optional: Rate limiting configuration
# RATE_LIMIT_MAX_REQUESTS=100
# RATE_LIMIT_WINDOW_MS=900000

# Optional: Log level
# LOG_LEVEL=info